{
  "name": "sidekick-llm",
  "version": "0.1.0",
  "description": "Privacy-first desktop knowledge system for local LLMs — AI Experts, grounded citations, and a corpus you own.",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "npm run rebuild:native",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "preview": "cross-env PREVIEW=true electron .",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron --test --experimental-test-isolation=none test/ollama.test.cjs test/search_memory.test.cjs test/repository.test.cjs test/profile_specialist.test.cjs test/context_builder.test.cjs test/roundtable.test.cjs test/encryption.test.cjs test/license.test.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:node": "node --test --experimental-test-isolation=none test/ollama.test.cjs test/search_memory.test.cjs",
    "test:electron": "cross-env ELECTRON_RUN_AS_NODE=1 electron --test --experimental-test-isolation=none test/repository.test.cjs test/profile_specialist.test.cjs test/context_builder.test.cjs test/roundtable.test.cjs test/encryption.test.cjs test/license.test.cjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "icon": "node build/make-icon.cjs",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3,better-sqlite3-multiple-ciphers",
    "postinstall": "npm run rebuild:native"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "electron-updater": "^6.8.9",
    "node-llama-cpp": "^3.20.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "author": {
    "name": "Sidekick LLM"
  },
  "build": {
    "appId": "com.sidekick.llm",
    "productName": "Sidekick LLM",
    "copyright": "Copyright © Sidekick LLM",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "LEGAL/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sidekick LLM"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^41.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "vite": "^8.0.5",
    "wait-on": "^8.0.1"
  }
}
